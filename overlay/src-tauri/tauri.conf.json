{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "companion-overlay",
  "version": "0.1.0",
  "identifier": "com.gpphack.companion",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Companion",
        "width": 340,
        "height": 240,
        "center": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "skipTaskbar": false,
        "visible": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "app"
  }
}
